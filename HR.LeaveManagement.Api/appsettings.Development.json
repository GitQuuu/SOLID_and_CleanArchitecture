{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EmailSettings": {
    "ApiKey": "",
    "FromAddress": "no-reply@hrsystems.com",
    "FromName": "HR Management system"
  },
  "ConnectionStrings": {
    "HrDatabaseConnectionString": "Data Source=hrLeaveManagement.db"
  },
  "JwtSettings": {
    "Key": "SecretKeyMustHaveSizeOfAtLeast128Bits",
    "Issuer": "HrLeaveManagement",
    "Audience": "HrLeaveManagementUser",
    "DurationInMinutes": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override":{
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "-logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
